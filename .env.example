# Upstox API Credentials
# Get these from https://developer.upstox.com/
UPSTOX_CLIENT_ID=your_client_id_here
UPSTOX_CLIENT_SECRET=your_client_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback

# Access token (auto-populated by scripts/authenticate.py)
UPSTOX_ACCESS_TOKEN=

# Telegram Bot (for trade notifications)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
