# Options trading package configuration
#
# These values are read from the project root .env. This file documents the
# option-strategy-specific keys kept under options_trading/ for clarity.

# Current/front-month Nifty futures instrument key used as the signal instrument.
NIFTY_FUTURES_KEY=NSE_FO|your_current_nifty_futures_key_here

# Nifty options spread execution.
NIFTY_OPTION_LOTS=1
NIFTY_OPTION_STRIKE_STEP=50
NIFTY_OPTION_SELL_OFFSET=500
NIFTY_OPTION_HEDGE_OFFSET=1000
NIFTY_OPTION_PRODUCT=I
PIVOT_REVERSAL_MONITOR_INTERVAL=1
